#include <Arduino.h>

enum MSG_TYPE
{
    QUACK,
    STICK_DATA,
};

inline const char *msg_type_name(MSG_TYPE msg_type)
{
    switch (msg_type)
    {
    case QUACK:
        return "QUACK";
    case STICK_DATA:
        return "STICK_DATA";
    default:
        return "UNKNOWN";
    }
}

struct __attribute((packed)) Message
{
    MSG_TYPE msg_type;
    union
    {
        uint16_t i;
        struct
        {
            uint16_t x;
            uint16_t y;
        };
    } data;
};
